# ==============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO - FRONTEND (Vite React)
# Copia este archivo como .env para desarrollo local:
#   cp .env.example .env
# ==============================================================================

# URL base de la API del Backend NestJS
# - Para desarrollo local: http://localhost:3000
# - Si se deja vacío, el frontend usará rutas relativas (/v1) a través del proxy de Vite o Nginx
VITE_API_URL=http://localhost:3000

# Nombre de la aplicación / Plataforma
VITE_APP_TITLE=Growth Intelligence - Productive Precision

# Entorno de la aplicación
VITE_APP_ENV=development
